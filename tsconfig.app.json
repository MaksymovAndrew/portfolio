{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        "resolveJsonModule": true,

        /* Bare path aliases */
        "paths": {
            "app/*": ["./src/app/*"],
            "components/*": ["./src/components/*"],
            "config/*": ["./src/config/*"],
            "constants/*": ["./src/constants/*"],
            "guards/*": ["./src/guards/*"],
            "hooks/*": ["./src/hooks/*"],
            "i18n/*": ["./src/i18n/*"],
            "styles/*": ["./src/styles/*"],
            "test/*": ["./src/test/*"],
            "types/*": ["./src/types/*"],
            "utils/*": ["./src/utils/*"],
            "content": ["./content/index.ts"],
            "content/*": ["./content/*"],
            "theme/*": ["./theme/*"]
        },

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",

        /* Linting */
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["src", "content", "theme"],
    "exclude": ["src/**/__tests__/**", "src/test/**", "src/guards/**"]
}
