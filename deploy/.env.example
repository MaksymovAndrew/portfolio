# Copy to /srv/portfolio/.env on the server and fill in SITE_DOMAIN.
# deploy.sh rewrites IMAGE and IMAGE_TAG on every release; a rollback restores the previous pair.

# ghcr.io/<owner>/portfolio
IMAGE=
# bootstrap until the first release: there is nothing to roll back to yet
IMAGE_TAG=bootstrap
# the public domain without a scheme, such as example.com; the deploy checks the site through it
SITE_DOMAIN=
