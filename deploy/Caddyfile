# Copied to /srv/edge/sites/portfolio.caddy on the server, where the shared Caddy imports every
# file of that folder. The domain is written out, so a change needs only a reload; both DNS
# records must resolve before it, or the certificate request fails.

andrii-maksymov.tech {
	log {
		output file /var/log/caddy/portfolio.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 2160h
		}
		format filter {
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			wrap json
		}
	}
	encode zstd gzip
	reverse_proxy portfolio-web:8080
}

www.andrii-maksymov.tech {
	redir https://andrii-maksymov.tech{uri} permanent
}
