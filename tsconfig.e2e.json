{
    // type-check view of the browser tests; Playwright compiles them itself at run time
    "extends": "./tsconfig.node.json",
    "compilerOptions": {
        "lib": ["ES2023", "DOM"],
        "paths": {
            "constants/*": ["./src/constants/*"],
            "content": ["./content/index.ts"],
            "content/*": ["./content/*"],
            "i18n/*": ["./src/i18n/*"],
            "theme/*": ["./theme/*"],
            "types/*": ["./src/types/*"],
            "utils/*": ["./src/utils/*"]
        }
    },
    "include": ["e2e", "playwright.config.ts"]
}
