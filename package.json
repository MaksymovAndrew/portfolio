{
    "name": "portfolio",
    "version": "0.1.0",
    "description": "Personal portfolio site that doubles as a template",
    "private": true,
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "node scripts/serve.mjs",
        "typecheck": "tsc -b tsconfig.build.json",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "lint:sonarjs": "eslint . --config eslint.sonarjs.config.js",
        "stylelint": "stylelint \"src/**/*.scss\"",
        "stylelint:fix": "stylelint \"src/**/*.scss\" --fix",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "verify": "npm run format:check && npm run lint && npm run lint:sonarjs && npm run stylelint && npm run typecheck && npm run test:coverage && npm run build",
        "bump": "node scripts/release-version.mjs bump",
        "prepare": "husky"
    },
    "dependencies": {
        "next": "^16.3.8",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "server-only": "^0.0.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^9.39.5",
        "@next/eslint-plugin-next": "^16.3.8",
        "@swc/core": "^1.16.13",
        "@swc/jest": "^0.2.39",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.19.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^7.2.0",
        "eslint-plugin-de-morgan": "^2.2.0",
        "eslint-plugin-i18next": "^6.1.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-testing-library": "^7.16.2",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.9",
        "sass": "^1.105.1",
        "stylelint": "^17.16.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0"
    }
}
